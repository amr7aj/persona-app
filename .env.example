# Server
PORT=3000
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Vite frontend
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Local web development uses the same origin as the Express/Vite server.
# Leave this empty locally. For a separately hosted production frontend or
# Capacitor build, set it to the deployed HTTPS API origin.
VITE_API_BASE_URL=

# Optional demo mode (development/staging only; keep disabled in production)
PERSONA_DEMO_MODE=false
PERSONA_DEMO_PASSWORD=CHANGE_ME_ONLY_FOR_DEMO_ACCOUNTS
VITE_DEMO_MODE=false

# One-time legacy Auth repair endpoint (server only)
PERSONA_MIGRATION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

# Optional staging-only behavior. Keep false in production until a real payment provider is integrated.
PERSONA_ALLOW_SELF_UPGRADE=false

# Optional Telegram webhook secret. The webhook endpoint remains disabled unless this is set.
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_TO_A_RANDOM_WEBHOOK_SECRET
